# Copy this file to .env.local for local development.
# In production (Vercel), add these under Project Settings -> Environment Variables.

# Password required to log into /admin. Choose something strong.
ADMIN_PASSWORD=change-me

# Random secret used to sign the admin login session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Postgres connection string used to persist content edited from /admin, so
# changes survive Vercel's serverless deploys/restarts. Get this from either:
#   - Vercel Dashboard -> Storage -> add a "Neon" (Postgres) integration, which
#     injects DATABASE_URL / POSTGRES_URL automatically, or
#   - a free account at https://neon.tech (create a project, copy the
#     connection string from the dashboard)
DATABASE_URL=
